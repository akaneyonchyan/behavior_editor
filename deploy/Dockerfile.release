FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production PORT=5110 PREVIEW_ONLY=true CONTAINER_PREVIEW=true BEHAVIOR_SOURCE=snapshot LIBRARY_SNAPSHOT_PATH=/app/dist/data/library.json
COPY --chown=node:node dist ./dist
COPY --chown=node:node server ./server
COPY --chown=node:node shared ./shared
USER node
EXPOSE 5110
CMD ["node","server/cloud-preview.mjs"]
